<template>
  <div class="mind-auth-shell">
    <div class="mind-auth-main">
      <div class="mind-auth-card">
        <div class="mind-auth-brand">
          <img src="/mindar-logo.png" alt="Mindar" class="mind-auth-logo" />
        </div>

        <!-- Join -->
        <template v-if="step === 'join'">
          <h1 class="mind-auth-title">{{ $t('mindarAuth.joinTitle') }}</h1>
          <p class="mind-auth-subtitle">{{ $t('mindarAuth.joinSubtitle') }}</p>

          <div v-if="oidcEnabled" class="mind-auth-actions">
            <button
              type="button"
              class="mind-auth-btn-social"
              :disabled="oidcLoading"
              @click="handleOIDCLogin"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" />
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
              </svg>
              {{ oidcLoginText }}
            </button>
          </div>

          <div v-if="oidcEnabled" class="mind-auth-divider">
            <span />
            <span>{{ $t('mindarAuth.or') }}</span>
            <span />
          </div>

          <form class="mind-auth-form" @submit.prevent="handleEmailContinue">
            <input
              v-model="email"
              type="email"
              autocomplete="email"
              class="mind-auth-input"
              :placeholder="$t('mindarAuth.emailPlaceholder')"
            />
            <button type="submit" class="mind-auth-btn-primary" :disabled="loading">
              {{ $t('mindarAuth.continue') }}
            </button>
          </form>

          <p class="mind-auth-legal">
            {{ $t('mindarAuth.legalPrefix') }}
            <a href="#">{{ $t('mindarAuth.terms') }}</a>
            {{ $t('mindarAuth.legalAnd') }}
            <a href="#">{{ $t('mindarAuth.privacy') }}</a>.
          </p>
        </template>

        <!-- Sign in -->
        <template v-else-if="step === 'sign-in'">
          <h1 class="mind-auth-title">{{ $t('auth.login') }}</h1>
          <p class="mind-auth-subtitle">
            {{ $t('mindarAuth.signInSubtitle') }}
            <strong>{{ email }}</strong>
          </p>

          <form class="mind-auth-form" style="margin-top: 2rem" @submit.prevent="handleLogin">
            <input
              v-model="password"
              type="password"
              autocomplete="current-password"
              class="mind-auth-input mind-auth-input--left"
              :placeholder="$t('auth.passwordPlaceholder')"
            />
            <button type="submit" class="mind-auth-btn-primary" :disabled="loading || !password">
              {{ loading ? $t('auth.loggingIn') : $t('auth.login') }}
            </button>
          </form>

          <div v-if="oidcEnabled" class="mind-auth-divider">
            <span />
            <span>{{ $t('mindarAuth.or') }}</span>
            <span />
          </div>
          <button
            v-if="oidcEnabled"
            type="button"
            class="mind-auth-btn-social"
            style="max-width: 320px; margin: 0 auto"
            :disabled="oidcLoading"
            @click="handleOIDCLogin"
          >
            {{ oidcLoading ? $t('auth.redirectingToOIDC') : oidcLoginText }}
          </button>

          <div class="mind-auth-row-2" style="max-width: 320px; margin-left: auto; margin-right: auto">
            <button type="button" class="mind-auth-btn-secondary" @click="goJoin">
              {{ $t('mindarAuth.back') }}
            </button>
          </div>

          <button type="button" class="mind-auth-toggle" @click="goRegister">
            {{ $t('auth.registerNow') }}
          </button>
        </template>

        <!-- Register -->
        <template v-else>
          <h1 class="mind-auth-title">{{ $t('auth.register') }}</h1>
          <p class="mind-auth-subtitle">{{ $t('auth.registerSubtitle') }}</p>

          <form class="mind-auth-form" style="margin-top: 2rem" @submit.prevent="handleRegister">
            <input
              v-model="registerData.username"
              type="text"
              autocomplete="username"
              class="mind-auth-input mind-auth-input--left"
              :placeholder="$t('auth.usernamePlaceholder')"
            />
            <input
              v-model="registerData.email"
              type="email"
              autocomplete="email"
              class="mind-auth-input mind-auth-input--left"
              :placeholder="$t('auth.emailPlaceholder')"
            />
            <input
              v-model="registerData.password"
              type="password"
              autocomplete="new-password"
              class="mind-auth-input mind-auth-input--left"
              :placeholder="$t('auth.passwordPlaceholder')"
            />
            <input
              v-model="registerData.confirmPassword"
              type="password"
              autocomplete="new-password"
              class="mind-auth-input mind-auth-input--left"
              :placeholder="$t('auth.confirmPasswordPlaceholder')"
            />
            <button type="submit" class="mind-auth-btn-primary" :disabled="loading">
              {{ loading ? $t('auth.registering') : $t('auth.register') }}
            </button>
          </form>

          <div class="mind-auth-row-2" style="max-width: 320px; margin-left: auto; margin-right: auto">
            <button type="button" class="mind-auth-btn-secondary" @click="goSignInFromRegister">
              {{ $t('mindarAuth.back') }}
            </button>
          </div>
        </template>

        <p class="mind-auth-footer">
          <router-link to="/landing">{{ $t('mindarAuth.home') }}</router-link>
          <span class="dot">·</span>
          <router-link to="/platform/knowledge-bases">{{ $t('mindarAuth.backToApp') }}</router-link>
        </p>
      </div>
    </div>

    <aside class="mind-auth-illustration" aria-hidden="true">
      <svg class="bg-art" viewBox="0 0 400 600" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M320 80c40 60 20 140-30 180M60 520c80-40 120-120 100-200M280 480c-60 20-100-80-70-150"
          stroke="#1a1a1a"
          stroke-width="1.2"
          stroke-linecap="round"
        />
        <ellipse cx="200" cy="320" rx="90" ry="28" stroke="#1a1a1a" stroke-width="1.2" />
        <circle cx="200" cy="280" r="42" stroke="#1a1a1a" stroke-width="1.2" />
        <path d="M340 120l12-8 8 14-20-6z" fill="#4ade80" stroke="#166534" stroke-width="0.8" />
        <path
          d="M80 100c20-30 50-40 70-20s10 50-20 60M300 500c-30 40-80 50-110 20"
          stroke="#1a1a1a"
          stroke-width="1"
          stroke-linecap="round"
        />
      </svg>
      <h2>{{ $t('mindarAuth.illustrationTitle') }}<br />{{ $t('mindarAuth.illustrationTitle2') }}</h2>
      <p class="tagline">{{ $t('mindarAuth.illustrationTagline') }}</p>
    </aside>
  </div>
</template>

<script setup lang="ts">
import { ref, reactive, computed, onMounted, onBeforeUnmount, nextTick } from 'vue'
import { useRouter } from 'vue-router'
import { MessagePlugin } from 'tdesign-vue-next'
import { useI18n } from 'vue-i18n'
import {
  login,
  register,
  getOIDCAuthorizationURL,
  getOIDCConfig,
  autoSetup,
} from '@/api/auth'
import { useAuthStore } from '@/stores/auth'
import '@/assets/theme/mind-auth-web.css'

type AuthStep = 'join' | 'sign-in' | 'register'

const router = useRouter()
const authStore = useAuthStore()
const { t, locale } = useI18n()

const step = ref<AuthStep>('join')
const email = ref('')
const password = ref('')
const loading = ref(false)
const oidcLoading = ref(false)
const oidcEnabled = ref(false)
const oidcProviderName = ref('')
const registerData = reactive({
  username: '',
  email: '',
  password: '',
  confirmPassword: '',
})

const oidcLoginText = computed(() => {
  if (oidcProviderName.value) {
    return t('auth.oidcLoginWithProvider', { provider: oidcProviderName.value })
  }
  return t('auth.oidcLogin')
})

const persistLoginResponse = async (response: {
  user?: { id?: string; username?: string; email?: string; avatar?: string; can_access_all_tenants?: boolean; role?: string; created_at?: string; updated_at?: string }
  tenant?: { id?: string | number; name?: string; api_key?: string; created_at?: string; updated_at?: string }
  token?: string
  refresh_token?: string
}) => {
  if (!response.user || !response.tenant || !response.token) return

  authStore.setUser({
    id: response.user.id || '',
    username: response.user.username || '',
    email: response.user.email || '',
    avatar: response.user.avatar,
    tenant_id: String(response.tenant.id) || '',
    can_access_all_tenants: response.user.can_access_all_tenants || false,
    role: response.user.role || '',
    created_at: response.user.created_at || new Date().toISOString(),
    updated_at: response.user.updated_at || new Date().toISOString(),
  })
  authStore.setToken(response.token)
  if (response.refresh_token) {
    authStore.setRefreshToken(response.refresh_token)
  }
  authStore.setTenant({
    id: String(response.tenant.id) || '',
    name: response.tenant.name || '',
    api_key: response.tenant.api_key || '',
    owner_id: response.user.id || '',
    created_at: response.tenant.created_at || new Date().toISOString(),
    updated_at: response.tenant.updated_at || new Date().toISOString(),
  })

  await nextTick()
  router.replace('/platform/knowledge-bases')
}

const getBackendOIDCRedirectURI = () => `${window.location.origin}/api/v1/auth/oidc/callback`

const loadOIDCConfig = async () => {
  try {
    const response = await getOIDCConfig()
    oidcEnabled.value = !!response.success && !!response.enabled
    oidcProviderName.value = response.provider_display_name || ''
  } catch {
    oidcEnabled.value = false
    oidcProviderName.value = ''
  }
}

const handleOIDCLogin = async () => {
  try {
    oidcLoading.value = true
    const response = await getOIDCAuthorizationURL(getBackendOIDCRedirectURI())
    if (!response.success || !response.authorization_url) {
      MessagePlugin.error(response.message || t('auth.oidcLoginFailed'))
      return
    }
    window.location.href = response.authorization_url
  } catch (error: unknown) {
    const msg = error instanceof Error ? error.message : t('auth.oidcLoginFailed')
    MessagePlugin.error(msg)
  } finally {
    oidcLoading.value = false
  }
}

function handleEmailContinue() {
  const trimmed = email.value.trim()
  if (!trimmed || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(trimmed)) {
    MessagePlugin.error(t('auth.emailInvalid'))
    return
  }
  email.value = trimmed
  password.value = ''
  step.value = 'sign-in'
}

function goJoin() {
  step.value = 'join'
  password.value = ''
}

function goRegister() {
  registerData.email = email.value
  registerData.username = ''
  registerData.password = ''
  registerData.confirmPassword = ''
  step.value = 'register'
}

function goSignInFromRegister() {
  email.value = registerData.email || email.value
  step.value = 'sign-in'
}

function validateRegister(): string | null {
  if (!registerData.username.trim() || registerData.username.length < 2) {
    return t('auth.usernameMinLength')
  }
  if (!registerData.email.trim() || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(registerData.email)) {
    return t('auth.emailInvalid')
  }
  if (!registerData.password || registerData.password.length < 8) {
    return t('auth.passwordMinLength')
  }
  if (registerData.password !== registerData.confirmPassword) {
    return t('auth.passwordMismatch')
  }
  return null
}

async function handleLogin() {
  if (!password.value) {
    MessagePlugin.error(t('auth.passwordRequired'))
    return
  }
  try {
    loading.value = true
    const response = await login({
      email: email.value,
      password: password.value,
    })
    if (response.success) {
      MessagePlugin.success(t('auth.loginSuccess'))
      await persistLoginResponse(response)
    } else {
      MessagePlugin.error(response.message || t('auth.loginError'))
    }
  } catch (error: unknown) {
    const msg = error instanceof Error ? error.message : t('auth.loginErrorRetry')
    MessagePlugin.error(msg)
  } finally {
    loading.value = false
  }
}

async function handleRegister() {
  const err = validateRegister()
  if (err) {
    MessagePlugin.error(err)
    return
  }
  try {
    loading.value = true
    const response = await register({
      username: registerData.username,
      email: registerData.email,
      password: registerData.password,
    })
    if (response.success) {
      MessagePlugin.success(t('auth.registerSuccess'))
      email.value = registerData.email
      step.value = 'sign-in'
      Object.assign(registerData, { username: '', email: '', password: '', confirmPassword: '' })
    } else {
      MessagePlugin.error(response.message || t('auth.registerFailed'))
    }
  } catch (error: unknown) {
    const msg = error instanceof Error ? error.message : t('auth.registerError')
    MessagePlugin.error(msg)
  } finally {
    loading.value = false
  }
}

onMounted(async () => {
  locale.value = 'en-US'
  await loadOIDCConfig()

  if (authStore.isLoggedIn) {
    router.replace('/platform/knowledge-bases')
    return
  }

  const AUTO_SETUP_FAILED_KEY = 'weknora_auto_setup_failed'
  if (localStorage.getItem(AUTO_SETUP_FAILED_KEY) !== 'true') {
    try {
      const response = await autoSetup()
      if (response.success) {
        authStore.setLiteMode(true)
        await persistLoginResponse(response)
      }
    } catch {
      /* stay on login */
    }
  }
})

</script>
